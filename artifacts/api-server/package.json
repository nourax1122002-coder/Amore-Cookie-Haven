{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test:payments": "node test/run-payments.mjs",
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p test/tsconfig.json --noEmit",
    "test:orders": "esbuild src/lib/orders.test.ts --bundle --platform=node --format=esm --outfile=/tmp/amore-orders.test.mjs && node --test /tmp/amore-orders.test.mjs",
    "test:orders:http": "node test/run-orders-http.mjs",
    "test:admin:http": "node test/run-orders-http.mjs admin-http",
    "test:tracking:shared": "esbuild src/lib/tracking-limits.pg.test.ts --bundle --platform=node --format=cjs --outfile=/tmp/amore-tracking-shared.test.cjs && NODE_ENV=production node --test /tmp/amore-tracking-shared.test.cjs",
    "test:currency": "esbuild src/lib/currency-conversion.test.ts --bundle --platform=node --format=esm --outfile=/tmp/amore-currency-conversion.test.mjs && node --test /tmp/amore-currency-conversion.test.mjs",
    "test:auth-errors": "esbuild src/lib/auth-errors.test.ts --bundle --platform=node --format=esm --outfile=/tmp/amore-auth-errors.test.mjs && node --test /tmp/amore-auth-errors.test.mjs",
    "test:auth": "node test/run-auth.mjs",
    "test:auth-email-limit": "esbuild src/lib/auth-email-limit.test.ts --bundle --platform=node --format=cjs --outfile=/tmp/amore-auth-email-limit.test.cjs && node --test /tmp/amore-auth-email-limit.test.cjs",
    "test:assistant": "node test/run-assistant.mjs",
    "test": "pnpm run test:orders && pnpm run test:orders:http && pnpm run test:admin:http && pnpm run test:tracking:shared && pnpm run test:payments && pnpm run test:assistant && pnpm run test:currency && pnpm run test:auth-errors && pnpm run test:auth && pnpm run test:auth-email-limit"
  },
  "dependencies": {
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "esbuild": "0.28.2",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.2.0",
    "thread-stream": "3.1.0"
  }
}
